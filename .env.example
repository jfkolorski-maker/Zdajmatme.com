# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zdajmatme.com
# Legal data (privacy policy + JSON-LD). Fill before launch.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_NIP=
NEXT_PUBLIC_CONTACT_EMAIL=
# Extra origins allowed to POST /api/leads (comma separated), e.g. preview domains
ALLOWED_ORIGINS=

# ─── CRM (server only – never prefixed with NEXT_PUBLIC_) ───────────────
# base44 | webhook | console (console = local dev only, refused in production)
CRM_PROVIDER=console
CRM_STATUS_NEW=Nowy
# Optional: value written to the "assigned to" field (e.g. Oliwia's user id / e-mail in the CRM)
CRM_ASSIGNEE=

# Base44 entities API
BASE44_API_URL=https://app.base44.com/api
BASE44_APP_ID=
BASE44_API_KEY=
BASE44_LEAD_ENTITY=Lead
# JSON map {"ourField":"base44Field"}; map a field to "" to skip it. See DEPLOYMENT.md
BASE44_FIELD_MAP=
# true (default) = arrays/objects sent as text; false = sent as JSON arrays/objects
BASE44_ARRAYS_AS_STRING=true

# Alternative: signed webhook (e.g. an existing Base44 backend function)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ─── Rate limit / idempotency store (recommended on serverless) ─────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional e-mails (Resend) ──────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
LEAD_NOTIFY_EMAIL=
SEND_CONFIRMATION_EMAIL=false

# ─── Tracking ───────────────────────────────────────────────────────────
# gtm | gtag | off   (never both – prevents duplicate conversions)
NEXT_PUBLIC_TRACKING_MODE=off
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_GADS_CALL_LABEL=
# Optional value reported with generate_lead (PLN). Leave empty/0 to send no value.
NEXT_PUBLIC_LEAD_VALUE=
NEXT_PUBLIC_ENHANCED_CONVERSIONS=false
# basic = tags load only after consent; advanced = tags load with Consent Mode denied pings
NEXT_PUBLIC_CONSENT_MODE=basic
