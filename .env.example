# ─── Lead delivery (FLIPOR engine) ─────────────────────────────────────────
# Where /api/leads forwards validated leads (JSON POST). Required – without it the form
# shows an error with the phone number instead of pretending success.
# Example: a Base44 backend function of the ZdajMatme CRM, or a Google Apps Script web app.
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header.
LEAD_WEBHOOK_SECRET=

# ─── Public site settings ──────────────────────────────────────────────────
# Canonical URL (metadata, sitemap, Open Graph). Default: Vercel production URL, then https://zdajmatme.com
NEXT_PUBLIC_SITE_URL=https://zdajmatme.com
# Contact overrides (defaults from zdajmatme.com: 730 170 804, zdajtoznami@gmail.com)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_URL=
# Legal data shown in the privacy policy and terms – fill before launch
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_IDS=

# ─── Google Ads ───────────────────────────────────────────────────────────
# Conversion ID (AW-…). Leave empty to disable gtag. The cookie banner shows only when a tracking ID is set.
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_GADS_CALL_LABEL=

# ─── Meta (Facebook / Instagram) Ads ──────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
